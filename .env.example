# ==============================================================================
# ARABULUCU AI - ORTAM DEĞİŞKENLERİ (.env.local)
# ==============================================================================
# GÜVENLİK UYARISI:
# API anahtarları yalnızca sunucu tarafında (Server Components / API Routes)
# process.env üzerinden okunur. İstemci (tarayıcı) tarafına sızmaması için
# kesinlikle "NEXT_PUBLIC_" öneki KULLANILMAMALIDIR.
# ==============================================================================

# Google Gemini API Anahtarı (Gerekli)
# https://aistudio.google.com/app/apikey adresinden temin edebilirsiniz.
GEMINI_API_KEY="your_gemini_api_key_here"

# Uygulama URL'si (İsteğe bağlı)
APP_URL="http://localhost:3000"
